# ============================================================
# Mobile App (Flutter) - Environment Variables
# ============================================================
# File nay duoc dong goi vao assets cua ung dung.
# Khong commit file nay neu chua API key nhay cam.
# ============================================================

# URL goc cua Backend API
API_BASE_URL=http://localhost:5000/api

# IP LAN (dung khi test tren dien thoai that cung mang Wi-Fi)
LAN_IP=192.168.100.201

# Port cua Backend
BACKEND_PORT=5000
