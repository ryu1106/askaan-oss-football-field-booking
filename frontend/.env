# ============================================================
# Frontend Web (React + Vite) - Environment Variables
# ============================================================
# Tat ca bien PHAI co tien to VITE_ de Vite nhung vao bundle.
# Sao chep file nay thanh .env.local de ghi de cuc bo.
# ============================================================

# URL goc cua Backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Ten ung dung hien thi tren tieu de
VITE_APP_NAME=San Bong Da Askaan
